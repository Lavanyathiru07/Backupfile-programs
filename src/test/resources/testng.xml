<!DOCTYPE suite SYSTEM "http://testng.org/testng-1.0.dtd" >
<suite name="BAT 2.0 Automation" verbose="1" parallel="methods"
	thread-count="25" preserve-order="false"
	data-provider-thread-count="30">

	<suite-files> 
		<suite-file 
		      path="./catSuiteCreate.xml" />
	</suite-files>

	<test name="WWW Booking">
		<classes>
			<class name="com.itqa.tests.WebBookingTestIT" />
		</classes>
	</test>

	<test name="TA Booking">
		<classes>
			<class name="com.itqa.tests.TABookingTestIT" />
		</classes>
	</test>

	<test name="CC Booking">
		<classes>
			<class name="com.itqa.tests.CCBookingTestIT" />
		</classes>
	</test>

	<test name="Non Booking">
		<classes>
			<class name="com.itqa.tests.NonBookingTestIT" />
		</classes>
	</test>

	<suite-files>
		<suite-file path="./catSuiteClose.xml" />
	</suite-files>

</suite>      



