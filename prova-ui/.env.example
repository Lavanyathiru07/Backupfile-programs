# Environment Configuration for Prova UI Test Framework

# Base Application URL
ENV=https://www.stg01.aws.allegiantair.com/

# Browser Configuration
HEADLESS=false
BROWSER=chromium

# CAT Integration Configuration
CAT_JOB_NAME=prova-ui-automation
CAT_BUILD_NO=1.0.0
CAT_ENV=stg
CAT_URL=https://cat.stg.allegiantair.com
CAT_API_PATH=/api/ui/results

# Optional: Jenkins/CI Build URL for screenshot links
# BUILD_URL=https://jenkins.example.com/job/prova-ui/123/

# Test Execution Settings
PARALLEL_WORKERS=5
DEFAULT_TIMEOUT=60000

# CI/CD Settings
CI=false
START_SERVER=false

# Reporting
REPORT_PATH=./reports
SCREENSHOT_PATH=./reports/images
ALLURE_RESULTS_PATH=./allure-results