# NPM configuration for private @g4 packages
# Configure private registry for @g4 scoped packages
@g4:registry=https://nexus.aws.allegiantair.com/repository/npm-group/
# Alternative: If using a different private registry, update the registry URL above
# For authentication, you need to set the NPM_TOKEN environment variable
# or configure the authentication token manually
 
# Fallback to public registry for other packages
registry=https://registry.npmjs.org/
