properties([
    parameters([
        choice(choices: ['stg01.aws'], description: 'Please select the environment from the list', name: 'ENV'),
        string(name: 'CUSTOM_TAGS', defaultValue: '', description: 'Cucumber tags (e.g., @demo, @smoke). Leave empty to run all tests.')
    ])
])

String jnlp = 'jnlp'
String jnlpDockerImage = 'docker-registry.default.svc:5000/pipe/gizmo-build-agent:rocky-v3.11'
String cpuResources = '4'
String memoryResources = '8Gi'
String pullNexusAwsRegistry = 'https://nexus.aws.allegiantair.com/repository/npm-group/'

String branchName = env.BRANCH_NAME ?: 'feature/TCOE-1758-Playwright-Jenkins-Job'
String gitRepoUrl = "https://github.com/AllegiantTravelCo/gqa-bat.git"
String credentialGitHub = 'jenkins-gizmo-github-app-access-token'
String nodeVersion = 'lts/hydrogen'
String buildTimestamp = new Date().format("yyyyMMdd_HHmmss")

addShortText(text: "Playwright E2E Tests", color: 'white', background: 'green', borderColor: 'white')
timestamps {
    ansiColor('xterm') {
        def label = "playwright-e2e-tests-${UUID.randomUUID().toString()}"

        podTemplate(
            cloud: 'openshift',
            label: label,
            name: "${jnlp}-playwright-e2e",
            serviceAccount: 'gizmo-slave',
            namespace: 'allegiant-ci',
            containers: generateContainer(jnlp, jnlpDockerImage, cpuResources, memoryResources),
            volumes: [
                emptyDirVolume(name: 'dshm', mountPath: '/dev/shm', memory: true),
                emptyDirVolume(mountPath: '/tmp', memory: false),
                emptyDirVolume(mountPath: '/home/jenkins/.cache', memory: false)
            ],
            envVars: [
                envVar(key: 'CAT_JOB_NAME', value: "${JOB_NAME}"),
                envVar(key: 'CAT_BUILD_NO', value: "${BUILD_NUMBER}"),
                envVar(key: 'DEFAULT_CAT_UI', value: "true"),
                envVar(key: 'CAT_ENV', value: "playwright-e2e-${params.ENV}"),
                envVar(key: 'CAT_URL', value: "https://cat.stg.allegiantair.com"),
                envVar(key: 'CAT_API_PATH', value: "/api/ui/results"),
                envVar(key: 'JOB_START_TIME', value: "${buildTimestamp}"),
                envVar(key: 'CI', value: "true"),
                envVar(key: 'PLAYWRIGHT_BROWSERS_PATH', value: "/home/jenkins/.cache/playwright"),
                envVar(key: 'TEST_ENVIRONMENT', value: "${params.ENV}"),
                envVar(key: 'PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD', value: "0"),
                envVar(key: 'DISPLAY', value: ":99"),
                envVar(key: 'HEADLESS', value: "true"),
                envVar(key: 'DEBIAN_FRONTEND', value: 'noninteractive'),
                envVar(key: 'PLAYWRIGHT_SKIP_VALIDATE_HOST_REQUIREMENTS', value: "true")
            ]
        ) {
            node(label) {
                stage('Git Checkout') {
                    container(jnlp) {
                        withCredentials([
                            usernamePassword(credentialsId: credentialGitHub, usernameVariable: 'GITHUB_APP', passwordVariable: 'GH_TOKEN')
                        ]) {
                            sh """
                            # Fallback git checkout method
                            if command -v gh &> /dev/null; then
                                echo "Using GitHub CLI for checkout"
                                gh auth setup-git
                                gh repo clone ${gitRepoUrl} ./
                            else
                                echo "GitHub CLI not available, using standard git clone"
                                git clone https://\$GITHUB_APP:\$GH_TOKEN@github.com/AllegiantTravelCo/gqa-bat.git ./
                            fi
                            git checkout ${branchName} || git checkout -b ${branchName} || echo "Branch already exists"
                            """
                        }
                    }
                }

                stage('Install Dependencies & Setup') {
                    container(jnlp) {
                        try {
                            sh """
                            #!/bin/bash -ex
                            
                            # Verify NVM and Node setup
                            if [ ! -f "\$NVM_DIR/nvm.sh" ]; then
                                echo "ERROR: NVM not found at \$NVM_DIR/nvm.sh"
                                exit 1
                            fi
                            
                            source "\$NVM_DIR/nvm.sh" &>/dev/null
                            nvm use ${nodeVersion} &>/dev/null || {
                                echo "Node version ${nodeVersion} not available, installing..."
                                nvm install ${nodeVersion}
                                nvm use ${nodeVersion}
                            }
                            
                            echo "Using Node version: \$(node --version)"
                            echo "Using NPM version: \$(npm --version)"
                            
                            npm config set registry "${pullNexusAwsRegistry}" -g
                            npm set strict-ssl false
                            
                            cd prova-ui
                            
                            # Skip husky and other problematic scripts
                            export HUSKY=0
                            export PLAYWRIGHT_SKIP_VALIDATE_HOST_REQUIREMENTS=true
                            export DISPLAY=:99
                            export PLAYWRIGHT_BROWSERS_PATH="/home/jenkins/.cache/playwright"
                            
                            # Install dependencies - allow scripts but skip husky
                            if [ -f "package-lock.json" ]; then
                                echo "Installing with npm ci"
                                npm ci --no-audit --no-fund
                            else
                                echo "Installing with npm install"
                                npm install --no-audit --no-fund
                            fi
                            
                            # Try to install browsers with multiple fallback strategies
                            echo "Installing Playwright browsers..."
                            
                            # Ensure browser cache directory exists
                            mkdir -p "/home/jenkins/.cache/playwright"
                            export PLAYWRIGHT_BROWSERS_PATH="/home/jenkins/.cache/playwright"
                            
                            # Install system dependencies for browsers (if needed)
                            echo "Installing system dependencies..."
                            
                            # Try multiple installation strategies
                            if ! npx playwright install chromium --with-deps 2>/dev/null; then
                                echo "Standard chromium install failed, trying alternative methods..."
                                if ! npx playwright install chromium 2>/dev/null; then
                                    echo "Basic chromium install failed, trying with force..."
                                    npx playwright install --force chromium || echo "Chromium install failed but continuing..."
                                fi
                            fi
                            
                            # Install only chromium for Jenkins to reduce resource usage
                            echo "Verifying chromium installation..."
                            npx playwright install-deps chromium || echo "Dependencies install failed but continuing..."
                            
                            # Verify browser setup
                            echo "Running browser verification..."
                            npm run verify-browsers || echo "Browser verification failed but continuing..."
                            
                            # Verify key dependencies
                            echo "Verifying installation..."
                            ls -la node_modules/@babel/register || echo "@babel/register not found"
                            ls -la node_modules/@cucumber/cucumber || echo "@cucumber/cucumber not found"
                            
                            echo "Setup completed successfully"
                            """
                            
                        } catch (e) {
                            currentBuild.result = 'FAILURE'
                            echo "Exception during installation/setup: ${e}"
                            throw e
                        }
                    }
                }

                // Code Quality Checks stage removed to focus on test execution
                // Linting can be added back later with proper ESLint configuration

                stage('Execute Playwright Tests') {
                    container(jnlp) {
                        try {
                            sh """
                            #!/bin/bash -e
                            source "\$NVM_DIR/nvm.sh" &>/dev/null
                            nvm use ${nodeVersion} &>/dev/null
                            
                            cd prova-ui
                            export TEST_ENVIRONMENT="${params.ENV}"
                            export PLAYWRIGHT_SKIP_VALIDATE_HOST_REQUIREMENTS=true
                            export HEADLESS=true
                            export CI=true
                            export PLAYWRIGHT_BROWSERS_PATH="/home/jenkins/.cache/playwright"
                            
                            # Use only chromium in Jenkins for stability
                            export PLAYWRIGHT_PROJECT="chromium"
                            
                            echo "Environment setup:"
                            echo "HEADLESS=\$HEADLESS"
                            echo "CI=\$CI"
                            echo "PLAYWRIGHT_BROWSERS_PATH=\$PLAYWRIGHT_BROWSERS_PATH"
                            echo "NODE_VERSION=\$(node --version)"
                            
                            # Verify test command exists by checking package.json
                            if ! grep -q '"test:cat-parallel"' package.json; then
                                echo "test:cat-parallel script not found, falling back to test:cat"
                                if [ -n "${params.CUSTOM_TAGS}" ] && [ "${params.CUSTOM_TAGS}" != "" ]; then
                                    npm run test:cat -- --tags '${params.CUSTOM_TAGS}'
                                else
                                    npm run test:cat
                                fi
                            else
                                # Run with parallel if available
                                if [ -n "${params.CUSTOM_TAGS}" ] && [ "${params.CUSTOM_TAGS}" != "" ]; then
                                    npm run test:cat-parallel -- --tags '${params.CUSTOM_TAGS}'
                                else
                                    npm run test:cat-parallel
                                fi
                            fi
                            """
                        } catch (e) {
                            currentBuild.result = 'UNSTABLE'
                            echo "Test execution had failures: ${e}"
                        }
                    }
                }

                stage('Generate Reports') {
                    container(jnlp) {
                        try {
                            sh """
                            #!/bin/bash +x
                            source "\$NVM_DIR/nvm.sh" &>/dev/null
                            nvm use ${nodeVersion} &>/dev/null
                            
                            cd prova-ui
                            
                            if [ -d "allure-results" ] && [ "\$(ls -A allure-results)" ]; then
                                npm run allure:generate
                            fi
                            """
                            
                            // Archive artifacts
                            archiveArtifacts artifacts: 'prova-ui/cucumber-report.html', allowEmptyArchive: true
                            archiveArtifacts artifacts: 'prova-ui/report.json', allowEmptyArchive: true
                            archiveArtifacts artifacts: 'prova-ui/allure-results/**/*', allowEmptyArchive: true
                            archiveArtifacts artifacts: 'prova-ui/allure-report/**/*', allowEmptyArchive: true
                            archiveArtifacts artifacts: 'prova-ui/test-results/**/*', allowEmptyArchive: true
                            archiveArtifacts artifacts: 'prova-ui/playwright-report/**/*', allowEmptyArchive: true
                            
                            // Publish HTML reports
                            publishHTML([
                                allowMissing: false,
                                alwaysLinkToLastBuild: true,
                                keepAll: true,
                                reportDir: 'prova-ui',
                                reportFiles: 'cucumber-report.html',
                                reportName: "Cucumber Test Report - ${params.ENV}"
                            ])
                            
                            // Publish Allure report if available
                            if (fileExists('prova-ui/allure-report/index.html')) {
                                publishHTML([
                                    allowMissing: true,
                                    alwaysLinkToLastBuild: true,
                                    keepAll: true,
                                    reportDir: 'prova-ui/allure-report',
                                    reportFiles: 'index.html',
                                    reportName: "Allure Test Report - ${params.ENV}"
                                ])
                            }
                            
                        } catch (e) {
                            echo "Report generation had issues: ${e}"
                        }
                    }
                }
            }
        }
    }
}

def generateContainer(String jnlp, String jnlpDockerImage, String cpuResources, String memoryResources) {
    def nlist = []

    nlist.add(containerTemplate(
        name: jnlp,
        image: jnlpDockerImage,
        workingDir: '/tmp',
        alwaysPullImage: true,
        args: '${computer.jnlpmac} ${computer.name}',
        runAsUser: '1001',
        resourceRequestCpu: cpuResources,
        resourceRequestMemory: memoryResources,
        resourceLimitCpu: cpuResources,
        resourceLimitMemory: memoryResources
    ))

    return nlist
}