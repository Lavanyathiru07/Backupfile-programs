{
  "file-name": ["on", {"style": "camelCase"}] ,
  "no-files-without-scenarios" : "on",
  "no-unnamed-features" : "on",
  "no-unnamed-scenarios" : "on",
  "no-dupe-scenario-names" :["on" ,"in-feature"],
  "no-dupe-feature-names" :"on" , 
  "no-scenario-outlines-without-examples" :"on" ,
  "keywords-in-logical-order" :"on" ,
  "no-unused-variables" : "on" ,  
  "no-empty-background" :"on"	,
  "no-examples-in-scenarios" :	"on",
  "one-space-between-tags" : "on" ,
  "no-empty-file": "on" ,
  "new-line-at-eof": ["on", "yes"],
  "name-length" : ["on", { "Feature": 250, "Scenario": 250, "Step": 100 }],
  "scenario-size": ["on", { "steps-length": { "Background": 10, "Scenario": 20 }}],
  "max-scenarios-per-file" : ["on", {"maxScenarios": 20, "countOutlineExamples": true}],
  "no-duplicate-tags" :"on" ,
  "no-multiple-empty-lines" :"on",
  "indentation" : [
    "off", {
      "Background": 0,
      "Scenario": 2,
      "Step": 4,
      "Examples": 0,
      "example": 2,
      "given": 6,
      "when": 6,
      "then": 6,
      "and": 6,
      "but": 6,
      "feature tag": 0,
      "scenario tag": 2     
    }
  ],  
  "no-superfluous-tags":"on",  
  "allowed-tags": ["off", {"tags": [""], "patterns": [""]}],
  "required-tags": ["off", {"tags": [""], "ignoreUntagged": true}],
  "no-partially-commented-tag-lines":"off"
}
 


